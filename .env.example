# --- Groq (OpenAI-совместимый API) ---
# Ключ получаем на console.groq.com, кладём сюда. В чат ключи не пересылаем.
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# Основная модель разбора
GROQ_MODEL=openai/gpt-oss-120b
# Запасная: включается на 429/413. Втрое дешевле по токенам, без reasoning-накладных
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b
# Лимиты бесплатного тарифа на всю команду: 1000 запросов в сутки, 8000 токенов в минуту.
# Поэтому кэш ответов обязателен, см. DATA_DIR/cache.

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Каталог с данными: база знаний, расписания, SQLite, кэш, исходящие письма.
# Локально — ./var, в контейнере — /data.
DATA_DIR=./var

# --- Почта ---
# mock: письма складываются в $DATA_DIR/outbox/*.eml, ничего не отправляется
# smtp: реальная отправка
#
# Согласованного ящика деканата/приёмной комиссии у нас нет, поэтому схема —
# "ящик пишет сам себе": SMTP_USER, MAIL_FROM и SUPPORT_EMAIL заполняются
# ОДНИМ И ТЕМ ЖЕ корпоративным адресом. Реальный адресат обращения — в теме
# письма и в первых строках тела (см. app/routing.py), сотрудник разбирает
# входящие и пересылает/отвечает вручную.
MAIL_MODE=mock
SMTP_HOST=
# 465 -> неявный TLS (SMTP_SSL), 587 -> STARTTLS. Код поддерживает оба порта,
# просто укажите тот, что даёт ваш почтовый провайдер.
SMTP_PORT=465
# Логин на SMTP-сервере — обычно совпадает с MAIL_FROM.
SMTP_USER=
SMTP_PASSWORD=
# Адрес в заголовке From. Пусто = ошибка при MAIL_MODE=smtp (иначе письмо не
# уйдёт от чужого имени); в mock-режиме пустое значение не мешает демо.
MAIL_FROM=
# Куда уходят сформированные обращения. Пусто = берётся MAIL_FROM (тот же ящик).
SUPPORT_EMAIL=

# --- Расписание ---
# Дата первого понедельника семестра. От неё считается чётность недели:
# ((дата - SEMESTER_START).days // 7) % 2 == 0 -> верхняя неделя
SEMESTER_START=2026-09-01
