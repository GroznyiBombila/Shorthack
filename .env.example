# --- Yandex Cloud (auth via API key) ---
# Ключ сервисного аккаунта: Authorization: Api-Key <YC_API_KEY>
YC_API_KEY=
# Идентификатор каталога (b1g...), нужен в modelUri и заголовке x-folder-id
YC_FOLDER_ID=

# YandexGPT / Foundation Models
YC_LLM_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YC_LLM_MODEL=yandexgpt/latest
YC_EMBED_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/textEmbedding

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Каталог с данными: база знаний, расписания, SQLite, кэш, исходящие письма.
# Локально — ./var, в контейнере — /data.
DATA_DIR=./var

# --- Почта ---
# mock: письма складываются в $DATA_DIR/outbox/*.eml, ничего не отправляется
# smtp: реальная отправка
MAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Куда уходят сформированные обращения
SUPPORT_EMAIL=

# --- Расписание ---
# Дата первого понедельника семестра. От неё считается чётность недели:
# ((дата - SEMESTER_START).days // 7) % 2 == 0 -> верхняя неделя
SEMESTER_START=2026-09-01
